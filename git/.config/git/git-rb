#!/bin/bash

# Rebase on Main Script - Automatically rebase current branch onto latest main/master/trunk
# Usage: ./rebase-on-main.sh [--interactive] [--force-update]

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Script options
INTERACTIVE=false
FORCE_UPDATE=false

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -i|--interactive)
            INTERACTIVE=true
            shift
            ;;
        -f|--force-update)
            FORCE_UPDATE=true
            shift
            ;;
        -h|--help)
            echo "Usage: $0 [options]"
            echo "Options:"
            echo "  -i, --interactive    Use interactive rebase"
            echo "  -f, --force-update   Force update main branch even if ahead"
            echo "  -h, --help          Show this help message"
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use --help for usage information"
            exit 1
            ;;
    esac
done

# Function to print colored output
print_color() {
    echo -e "${1}${2}${NC}"
}

# Function to print step headers
print_step() {
    echo
    print_color $CYAN "=== $1 ==="
}

# Function to confirm user action
confirm() {
    read -p "$(echo -e ${YELLOW}"$1 (y/N): "${NC})" -n 1 -r
    echo
    [[ $REPLY =~ ^[Yy]$ ]]
}

# Function to check if we're in a git repository
check_git_repo() {
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        print_color $RED "Error: Not in a git repository!"
        exit 1
    fi
}

# Function to check if working directory is clean
check_working_directory() {
    if ! git diff-index --quiet HEAD --; then
        print_color $RED "Error: Working directory is not clean!"
        print_color $YELLOW "Please commit or stash your changes before rebasing."
        git status --short
        exit 1
    fi
}

# Function to detect the main branch name
detect_main_branch() {
    local possible_mains=("main" "master" "trunk")
    local remote_name=$(git remote | head -n1)  # Get first remote (usually origin)
    
    if [ -z "$remote_name" ]; then
        print_color $RED "Error: No remote repository found!"
        exit 1
    fi
    
    print_step "Detecting main branch"
    print_color $BLUE "Remote: $remote_name"
    
    # First, try to get the default branch from remote
    local default_branch=$(git symbolic-ref refs/remotes/$remote_name/HEAD 2>/dev/null | sed "s@^refs/remotes/$remote_name/@@" || echo "")
    
    if [ -n "$default_branch" ]; then
        print_color $GREEN "✓ Default branch detected: $default_branch"
        echo "$remote_name/$default_branch"
        return 0
    fi
    
    # If that fails, check which of the common main branches exist on remote
    for branch in "${possible_mains[@]}"; do
        if git show-ref --verify --quiet refs/remotes/$remote_name/$branch; then
            print_color $GREEN "✓ Main branch detected: $branch"
            echo "$remote_name/$branch"
            return 0
        fi
    done
    
    # If none found, list available remote branches and ask user
    print_color $YELLOW "Could not automatically detect main branch."
    print_color $BLUE "Available remote branches:"
    git branch -r | grep -v "HEAD" | sed 's/.*\///' | sort | uniq
    
    read -p "Please enter the main branch name: " user_branch
    if [ -z "$user_branch" ]; then
        print_color $RED "Error: No branch name provided!"
        exit 1
    fi
    
    if git show-ref --verify --quiet refs/remotes/$remote_name/$user_branch; then
        echo "$remote_name/$user_branch"
    else
        print_color $RED "Error: Branch '$user_branch' not found on remote '$remote_name'!"
        exit 1
    fi
}

# Function to get current branch name
get_current_branch() {
    git branch --show-current
}

# Function to update main branch
update_main_branch() {
    local main_branch_ref=$1
    local remote_name=$(echo $main_branch_ref | cut -d'/' -f1)
    local branch_name=$(echo $main_branch_ref | cut -d'/' -f2)
    
    print_step "Updating main branch from remote"
    
    # Check if we have the local branch
    if git show-ref --verify --quiet refs/heads/$branch_name; then
        local current_branch=$(get_current_branch)
        
        # If we're currently on the main branch, just pull
        if [ "$current_branch" = "$branch_name" ]; then
            print_color $BLUE "Currently on $branch_name, pulling latest changes..."
            git pull $remote_name $branch_name
        else
            # Switch to main branch temporarily to update it
            print_color $BLUE "Switching to $branch_name to update..."
            git checkout $branch_name
            
            # Check if local branch is ahead of remote
            local ahead=$(git rev-list --count $remote_name/$branch_name..$branch_name 2>/dev/null || echo "0")
            
            if [ "$ahead" -gt 0 ] && [ "$FORCE_UPDATE" = false ]; then
                print_color $YELLOW "Warning: Local $branch_name is $ahead commits ahead of remote!"
                if ! confirm "Force update anyway? (This will lose local commits)"; then
                    print_color $RED "Aborted: Local $branch_name has unpushed commits"
                    exit 1
                fi
            fi
            
            if [ "$ahead" -gt 0 ]; then
                git reset --hard $remote_name/$branch_name
                print_color $YELLOW "⚠️  Local $branch_name reset to match remote"
            else
                git pull $remote_name $branch_name
            fi
            
            # Switch back to original branch
            git checkout $current_branch
        fi
    else
        # Create local tracking branch
        print_color $BLUE "Creating local tracking branch for $branch_name..."
        git checkout -b $branch_name $main_branch_ref
        git checkout $(get_current_branch)
    fi
    
    print_color $GREEN "✓ Main branch updated"
}

# Function to perform the rebase
perform_rebase() {
    local main_branch_ref=$1
    local current_branch=$2
    local branch_name=$(echo $main_branch_ref | cut -d'/' -f2)
    
    print_step "Rebasing $current_branch onto $branch_name"
    
    # Show what we're about to do
    print_color $BLUE "Current branch: $current_branch"
    print_color $BLUE "Target branch: $branch_name"
    
    # Check if there are commits to rebase
    local commits_to_rebase=$(git rev-list --count $branch_name..$current_branch 2>/dev/null || echo "0")
    
    if [ "$commits_to_rebase" -eq 0 ]; then
        print_color $GREEN "✓ Branch is already up to date with $branch_name"
        return 0
    fi
    
    print_color $BLUE "Commits to rebase: $commits_to_rebase"
    print_color $BLUE "Recent commits on $current_branch:"
    git log --oneline $branch_name..$current_branch | head -5
    
    if ! confirm "Proceed with rebase?"; then
        print_color $YELLOW "Rebase cancelled"
        exit 0
    fi
    
    # Perform the rebase
    if [ "$INTERACTIVE" = true ]; then
        print_color $BLUE "Starting interactive rebase..."
        git rebase -i $branch_name
    else
        print_color $BLUE "Starting rebase..."
        git rebase $branch_name
    fi
    
    if [ $? -eq 0 ]; then
        print_color $GREEN "✓ Rebase completed successfully!"
        
        # Show the result
        print_color $BLUE "Updated branch log:"
        git log --oneline -5
    else
        print_color $RED "Rebase encountered conflicts or errors"
        print_color $YELLOW "To continue: resolve conflicts and run 'git rebase --continue'"
        print_color $YELLOW "To abort: run 'git rebase --abort'"
        exit 1
    fi
}

# Function to show summary
show_summary() {
    local main_branch_ref=$1
    local current_branch=$2
    local branch_name=$(echo $main_branch_ref | cut -d'/' -f2)
    
    print_step "Summary"
    print_color $GREEN "✓ Successfully rebased $current_branch onto latest $branch_name"
    
    # Show if branch can be fast-forwarded
    local behind=$(git rev-list --count $current_branch..$branch_name 2>/dev/null || echo "0")
    local ahead=$(git rev-list --count $branch_name..$current_branch 2>/dev/null || echo "0")
    
    print_color $BLUE "Branch status:"
    print_color $BLUE "  • $ahead commits ahead of $branch_name"
    print_color $BLUE "  • $behind commits behind $branch_name"
    
    if [ "$ahead" -gt 0 ]; then
        print_color $YELLOW "Next steps:"
        print_color $YELLOW "  • Review your changes: git log $branch_name..$current_branch"
        print_color $YELLOW "  • Push your branch: git push origin $current_branch --force-with-lease"
    fi
}

# Main script execution
main() {
    print_color $GREEN "Git Rebase on Main - Automatically rebase onto latest main/master/trunk"
    
    # Check prerequisites
    check_git_repo
    check_working_directory
    
    # Get current branch
    local current_branch=$(get_current_branch)
    
    if [ -z "$current_branch" ]; then
        print_color $RED "Error: Not on any branch (detached HEAD state)"
        exit 1
    fi
    
    print_color $BLUE "Current branch: $current_branch"
    
    # Detect main branch
    local main_branch_ref=$(detect_main_branch)
    local branch_name=$(echo $main_branch_ref | cut -d'/' -f2)
    
    # Check if we're already on the main branch
    if [ "$current_branch" = "$branch_name" ]; then
        print_color $YELLOW "You're already on the main branch ($branch_name)"
        if confirm "Update $branch_name from remote?"; then
            update_main_branch $main_branch_ref
        fi
        exit 0
    fi
    
    # Fetch latest changes
    print_step "Fetching latest changes"
    git fetch --all --prune
    print_color $GREEN "✓ Fetch completed"
    
    # Update main branch
    update_main_branch $main_branch_ref
    
    # Perform rebase
    perform_rebase $main_branch_ref $current_branch
    
    # Show summary
    show_summary $main_branch_ref $current_branch
}

# Run main function
main "$@"
